<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">


    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thanh Toán ZaloPay"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A73E8"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <!-- Thông tin thanh toán -->
    <LinearLayout
        android:id="@+id/llPaymentDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/tvTitle"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_card"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAmountLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Số tiền:"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF5722" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="đ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF5722" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="10dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/lblZpTransToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã giao dịch: "
                android:textSize="14sp"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/txtToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12345678"
                android:textSize="14sp"
                android:textColor="#555555" />
        </LinearLayout>

    </LinearLayout>

    <!-- Nút Thanh Toán -->
    <Button
        android:id="@+id/btnCreateOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/llPaymentDetails"
        android:layout_marginTop="40dp"
        android:backgroundTint="#1A73E8"
        android:text="Tạo giao dịch"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:padding="12dp"
        android:layout_marginHorizontal="16dp"/>
    <Button
        android:id="@+id/btnPay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/llPaymentDetails"
        android:layout_marginTop="40dp"
        android:backgroundTint="#1A73E8"
        android:text="Thanh Toán Ngay"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:padding="12dp"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"/>
    <!-- Logo ZaloPay -->
    <ImageView
        android:id="@+id/imgZaloPayLogo"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:contentDescription="@string/zalopay"
        android:src="@drawable/imageview_zalo"
        android:scaleType="fitCenter"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"/>

</RelativeLayout>
