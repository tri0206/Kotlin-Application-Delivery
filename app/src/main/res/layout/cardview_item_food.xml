<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@android:color/white"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/imageview_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@drawable/imageview_zalo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/textview_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên món ăn"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDiscountStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang giảm giá"
            android:textColor="@android:color/holo_red_dark"
            android:visibility="gone"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_gravity="end">

            <ImageButton
                android:id="@+id/btnViewFood"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:selectableItemBackground"
                android:contentDescription="Xem"
                android:src="@drawable/ic_view"
                app:tint="@color/gray" />

            <ImageButton
                android:id="@+id/btnEditFood"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:selectableItemBackground"
                android:contentDescription="Sửa"
                android:src="@drawable/ic_edit"
                app:tint="@color/primary_map_color" />

            <ImageButton
                android:id="@+id/btnDiscountFood"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:selectableItemBackground"
                android:contentDescription="Thêm giảm giá"
                android:src="@drawable/ic_discount"
                app:tint="@color/primary_color" />

            <ImageButton
                android:id="@+id/btnDeleteFood"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:selectableItemBackground"
                android:contentDescription="Xóa"
                android:src="@drawable/ic_delete_black"
                app:tint="@android:color/holo_red_dark"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>


</LinearLayout>
